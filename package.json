{
  "name": "ai-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "thesis:hwpx": "esbuild scripts/thesis-hwpx.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/ai-wiki-verify/thesis-hwpx.cjs --log-level=warning && node node_modules/.cache/ai-wiki-verify/thesis-hwpx.cjs",
    "verify": "esbuild tests/verify.ts --bundle --platform=node --format=cjs --loader:.md=text --outfile=node_modules/.cache/ai-wiki-verify/verify.cjs --log-level=warning && node node_modules/.cache/ai-wiki-verify/verify.cjs",
    "verify:cloud": "esbuild src/lib/cloud-state.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ai-wiki-verify/cloud-state.mjs --log-level=warning && esbuild src/lib/data.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ai-wiki-verify/data.mjs --log-level=warning && node tests/cloud.mjs && node tests/cloud-split.mjs",
    "verify:server": "esbuild src/lib/session-key.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ai-wiki-verify/session-key.mjs --log-level=warning && node tests/server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.6.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": "24.x"
  }
}
